rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile document owned by the authenticated user.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;

      // Cloud academic backup owned by the authenticated user.
      match /backups/{backupId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      // Online profile mirror used by the Android Profile screen.
      match /profile/{profileId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
